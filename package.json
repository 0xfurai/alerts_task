{
  "name": "units-interview",
  "private": true,
  "version": "1.0.0",
  "main": "mobile/index.ts",
  "scripts": {
    "server": "tsx server/src/index.ts",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "test": "jest --config jest.config.json --runInBand --passWithNoTests",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.mobile.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.80.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native/babel-preset": "^0.80.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react-test-renderer": "^19.1.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
